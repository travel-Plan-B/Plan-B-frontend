  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": ["message"],
        "title": "ChatRequest"
      },
      "DetailRecommendRequest": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "place_id": {
            "type": "string",
            "title": "Place Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "prev_item_location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_item_location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_item_start_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Item Start Time"
          },
          "current_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Time"
          },
          "priority": {
            "type": "string",
            "title": "Priority",
            "default": "MINIMIZE_TRAVEL"
          },
          "transport": {
            "type": "string",
            "title": "Transport",
            "default": "CAR"
          },
          "problem_reason": {
            "type": "string",
            "title": "Problem Reason"
          },
          "situational_answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Situational Answer"
          }
        },
        "type": "object",
        "required": ["item_id", "place_id", "source", "problem_reason"],
        "title": "DetailRecommendRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": ["lat", "lng"],
        "title": "Location"
      },
      "NextFixedItem": {
        "properties": {
          "start_time": {
            "type": "string",
            "title": "Start Time"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          }
        },
        "type": "object",
        "required": ["start_time", "location"],
        "title": "NextFixedItem"
      },
      "SimpleRecommendRequest": {
        "properties": {
          "current_location": {
            "$ref": "#/components/schemas/Location"
          },
          "next_place": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          },
          "deadline_time": {
            "type": "string",
            "title": "Deadline Time"
          },
          "current_time": {
            "type": "string",
            "title": "Current Time"
          },
          "transport": {
            "type": "string",
            "title": "Transport",
            "default": "CAR"
          },
          "problem_reason": {
            "type": "string",
            "title": "Problem Reason"
          },
          "situational_answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Situational Answer"
          },
          "sort": {
            "type": "string",
            "title": "Sort",
            "default": "RECOMMENDED"
          }
        },
        "type": "object",
        "required": [
          "current_location",
          "deadline_time",
          "current_time",
          "problem_reason"
        ],
        "title": "SimpleRecommendRequest"
      },
      "ValidateRequest": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "new_start_time": {
            "type": "string",
            "title": "New Start Time"
          },
          "new_duration_minutes": {
            "type": "integer",
            "title": "New Duration Minutes"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "next_fixed_item": {
            "$ref": "#/components/schemas/NextFixedItem"
          },
          "transport": {
            "type": "string",
            "title": "Transport",
            "default": "CAR"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "new_start_time",
          "new_duration_minutes",
          "location",
          "next_fixed_item"
        ],
        "title": "ValidateRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
