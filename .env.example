# Enable browser MSW only in local mock development (true/false)
NEXT_PUBLIC_API_MOCKING=

# Backend API origin
NEXT_PUBLIC_API_BASE_URL=

# Kakao Maps JavaScript SDK app key
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# ODsay Web API key (exposed to the browser and restricted by registered domain)
NEXT_PUBLIC_ODSAY_API_KEY=
